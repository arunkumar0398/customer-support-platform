# TEMPLATE ONLY. The Codex implementation must document exact placement,
# e.g. api/.env for local runtime and protected Vercel/CI environment settings.
# Never store actual secrets or demo-user plaintext passwords here.
NODE_ENV=development
PORT=3001
# Local PostgreSQL for MVP; hosted Vercel uses Neon POOLED URL.
DATABASE_URL=postgresql://app:LOCAL_ONLY_CHANGE_ME@localhost:5432/support_dev?schema=public
# Prisma CLI migrations must use local direct URL or Neon direct/unpooled URL.
DATABASE_URL_UNPOOLED=postgresql://app:LOCAL_ONLY_CHANGE_ME@localhost:5432/support_dev?schema=public
# Real SESSION_SECRET is generated securely, never checked in.
SESSION_SECRET=REPLACE_IN_LOCAL_ENV_WITH_RANDOM_VALUE
# Set only approved exact origins; the app must confirm rewrite/cookie behavior.
APP_ORIGIN=http://localhost:5173
