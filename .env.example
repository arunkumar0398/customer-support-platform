# TEMPLATE ONLY. Copy to the repository-root .env for local Docker Compose/API use.
# Never store actual secrets or demo-user plaintext passwords here.
NODE_ENV=development
PORT=3101
HOST=127.0.0.1
# Local PostgreSQL for MVP; hosted Vercel uses Neon POOLED URL.
PGPORT=5433
# Optional loopback port for the production-like web container.
WEB_PORT=8080
POSTGRES_SUPERUSER_PASSWORD=LOCAL_ONLY_SET_A_RANDOM_LOCAL_VALUE
APP_DB_PASSWORD=LOCAL_ONLY_SET_A_RANDOM_LOCAL_VALUE
TEST_DB_PASSWORD=LOCAL_ONLY_SET_A_RANDOM_LOCAL_VALUE
DATABASE_URL=postgresql://support_dev:LOCAL_ONLY_SET_A_RANDOM_LOCAL_VALUE@localhost:5433/support_dev?schema=public
# Prisma CLI migrations must use local direct URL or Neon direct/unpooled URL.
DATABASE_URL_UNPOOLED=postgresql://support_dev:LOCAL_ONLY_SET_A_RANDOM_LOCAL_VALUE@localhost:5433/support_dev?schema=public
# Disposable tests must target the isolated support_test database and role.
TEST_DATABASE_URL=postgresql://support_test:LOCAL_ONLY_SET_A_RANDOM_LOCAL_VALUE@localhost:5433/support_test?schema=public
# Real SESSION_SECRET is generated securely, never checked in.
SESSION_SECRET=REPLACE_IN_LOCAL_ENV_WITH_RANDOM_VALUE
# Set only approved exact origins; the app must confirm rewrite/cookie behavior.
APP_ORIGIN=http://localhost:5173
